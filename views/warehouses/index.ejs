<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-building"></i> Warehouses</h2>
    <a href="/warehouses/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Warehouse</a>
  </div>
  <%- include('../partials/flash') %>
  <div class="list-card">
    <div class="list-header">
      <h5>Warehouse Hubs</h5>
      <span class="text-muted" style="font-size: 0.85rem;">Manage locations where master loads are received and split</span>
    </div>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead style="background: #f9fafb; font-size: 0.85rem; color: var(--text-muted);">
          <tr>
            <th class="border-0 rounded-start">#</th>
            <th class="border-0">Name</th>
            <th class="border-0">Code</th>
            <th class="border-0">City</th>
            <th class="border-0">Status</th>
            <th class="border-0 rounded-end text-end" style="width:120px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (warehouses.length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted py-5">
              <i class="bi bi-building fs-1 text-light mb-3 d-block"></i>
              No warehouses found.<br>
              <a href="/warehouses/create" class="btn btn-sm btn-outline-primary mt-2">Add Warehouse</a>
            </td></tr>
          <% } %>
          <% warehouses.forEach((item, i) => { %>
            <tr style="border-bottom: 1px solid #f3f4f6;">
              <td class="text-muted"><%= i + 1 %></td>
              <td class="fw-bold text-primary"><%= item.name ?? '-' %></td>
              <td><span class="badge bg-light text-dark border"><%= item.code ?? '-' %></span></td>
              <td><%= item.city ?? '-' %></td>
              <td>
                <% if(item.status === 'Active') { %> <span class="badge-soft badge-available">Active</span>
                <% } else if(item.status === 'Inactive') { %> <span class="badge bg-secondary">Inactive</span>
                <% } else { %> <span class="badge bg-secondary"><%= item.status %></span> <% } %>
              </td>
              <td class="text-end">
                <a href="/warehouses/<%= item.id %>" class="btn btn-sm btn-light text-primary"><i class="bi bi-eye"></i></a>
                <a href="/warehouses/<%= item.id %>/edit" class="btn btn-sm btn-light text-warning"><i class="bi bi-pencil"></i></a>
                <form action="/warehouses/<%= item.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this record?');">
                  <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

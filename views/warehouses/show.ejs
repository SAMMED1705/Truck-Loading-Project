<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-building"></i> Warehouse Details</h2>
    <div>
      <a href="/warehouses/<%= warehouse.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/warehouses" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Name</th><td><%= warehouse.name ?? '-' %></td></tr>
        <tr><th style="width:240px;">Code</th><td><%= warehouse.code ?? '-' %></td></tr>
        <tr><th style="width:240px;">City</th><td><%= warehouse.city ?? '-' %></td></tr>
        <tr><th style="width:240px;">Phone</th><td><%= warehouse.contact_phone ?? '-' %></td></tr>
        <tr><th style="width:240px;">Status</th><td><%= warehouse.status ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>

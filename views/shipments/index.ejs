<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-box"></i> Shipments</h2>
    <a href="/shipments/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Shipment</a>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light"><tr><th style="width:60px;">#</th>
            <th>Shipment No.</th>
            <th>Pickup</th>
            <th>Delivery</th>
            <th>Freight</th>
            <th>Status</th>
            <th style="width:180px;">Actions</th></tr></thead>
        <tbody>
          <% if (shipments.length === 0) { %>
            <tr><td colspan="50" class="text-center text-muted py-4">No records yet.</td></tr>
          <% } %>
          <% shipments.forEach((item, i) => { %>
            <tr><td><%= i + 1 %></td>
            <td><%= item.shipment_number ?? '-' %></td>
            <td><%= item.pickup_location ?? '-' %></td>
            <td><%= item.delivery_location ?? '-' %></td>
            <td><%= item.freight_amount ?? '-' %></td>
            <td><span class="badge bg-secondary"><%= item.status %></span></td>
            <td>
              <a href="/shipments/<%= item.id %>" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
              <a href="/shipments/<%= item.id %>/edit" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
              <form action="/shipments/<%= item.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this record?');">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div></div>
</main>

<%- include('../partials/footer') %>

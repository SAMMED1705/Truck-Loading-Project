<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-box"></i> Shipment Details</h2>
    <div>
      <a href="/shipments/<%= shipment.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/shipments" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Shipment No.</th><td><%= shipment.shipment_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">Pickup</th><td><%= shipment.pickup_location ?? '-' %></td></tr>
        <tr><th style="width:240px;">Delivery</th><td><%= shipment.delivery_location ?? '-' %></td></tr>
        <tr><th style="width:240px;">Freight</th><td><%= shipment.freight_amount ?? '-' %></td></tr>
        <tr><th style="width:240px;">Status</th><td><%= shipment.status ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-box-seam"></i> Load Details</h2>
    <div>
      <a href="/loads/<%= load.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/loads" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Load No.</th><td><%= load.load_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">Commodity</th><td><%= load.commodity ?? '-' %></td></tr>
        <tr><th style="width:240px;">Origin</th><td><%= load.origin ?? '-' %></td></tr>
        <tr><th style="width:240px;">Destination</th><td><%= load.destination ?? '-' %></td></tr>
        <tr><th style="width:240px;">Weight (KG)</th><td><%= load.weight_kg ?? '-' %></td></tr>
        <tr><th style="width:240px;">Pickup From</th><td><%= load.pickup_from ?? '-' %></td></tr>
        <tr><th style="width:240px;">Offered Price</th><td><%= load.offered_price ?? '-' %></td></tr>
        <tr><th style="width:240px;">Status</th><td><%= load.status ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-box-seam"></i> Loads</h2>
    <a href="/loads/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Load</a>
  </div>
  <%- include('../partials/flash') %>
  <div class="list-card">
    <div class="list-header">
      <h5>Available Loads</h5>
      <span class="text-muted" style="font-size: 0.85rem;">Manage all loads posted by vendors and brokers</span>
    </div>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead style="background: #f9fafb; font-size: 0.85rem; color: var(--text-muted);">
          <tr>
            <th class="border-0 rounded-start">#</th>
            <th class="border-0">Load No.</th>
            <th class="border-0">Commodity</th>
            <th class="border-0">Origin <i class="bi bi-arrow-right mx-1"></i> Destination</th>
            <th class="border-0">Weight</th>
            <th class="border-0">Price</th>
            <th class="border-0">Status</th>
            <th class="border-0 rounded-end text-end" style="width:120px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (loads.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-5">
              <i class="bi bi-box-seam fs-1 text-light mb-3 d-block"></i>
              No loads posted yet.<br>
              <a href="/loads/create" class="btn btn-sm btn-outline-primary mt-2">Post a Load</a>
            </td></tr>
          <% } %>
          <% loads.forEach((item, i) => { %>
            <tr style="border-bottom: 1px solid #f3f4f6;">
              <td class="text-muted"><%= i + 1 %></td>
              <td class="fw-bold text-primary"><%= item.load_number ?? '-' %></td>
              <td><%= item.commodity ?? '-' %></td>
              <td>
                <span class="fw-medium"><%= item.origin ?? '-' %></span> 
                <i class="bi bi-arrow-right text-muted mx-1"></i> 
                <span class="fw-medium"><%= item.destination ?? '-' %></span>
              </td>
              <td><span class="badge bg-light text-dark border"><%= item.weight_kg ?? '-' %> KG</span></td>
              <td class="fw-bold text-success">₹ <%= item.offered_price ?? '-' %></td>
              <td>
                <% if(item.status === 'Open') { %> <span class="badge-soft badge-available">Open</span>
                <% } else if(item.status === 'Booked') { %> <span class="badge-soft badge-transit">Booked</span>
                <% } else { %> <span class="badge bg-secondary"><%= item.status %></span> <% } %>
              </td>
              <td class="text-end">
                <a href="/loads/<%= item.id %>" class="btn btn-sm btn-light text-primary"><i class="bi bi-eye"></i></a>
                <a href="/loads/<%= item.id %>/edit" class="btn btn-sm btn-light text-warning"><i class="bi bi-pencil"></i></a>
                <form action="/loads/<%= item.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this record?');">
                  <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

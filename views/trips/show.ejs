<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-geo-alt"></i> Trip Details</h2>
    <div>
      <a href="/trips/<%= trip.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/trips" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Trip No.</th><td><%= trip.trip_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">Start Date</th><td><%= trip.start_date ?? '-' %></td></tr>
        <tr><th style="width:240px;">Start Location</th><td><%= trip.start_location ?? '-' %></td></tr>
        <tr><th style="width:240px;">End Location</th><td><%= trip.end_location ?? '-' %></td></tr>
        <tr><th style="width:240px;">Status</th><td><%= trip.status ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>

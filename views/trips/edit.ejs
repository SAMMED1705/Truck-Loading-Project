<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-geo-alt"></i> Edit Trip</h2>
    <a href="/trips" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <form action="/trips/<%= trip.id %>?_method=PUT" method="POST">
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Trip No. <span class="text-danger">*</span></label>
      <input type="text" name="trip_number" class="form-control"  value="<%= trip.trip_number ?? '' %>" required>
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">Start Date</label>
      <input type="datetime-local" name="start_date" class="form-control"  value="<%= trip.start_date ?? '' %>" >
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">Start Location</label>
      <input type="text" name="start_location" class="form-control"  value="<%= trip.start_location ?? '' %>" >
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">End Location</label>
      <input type="text" name="end_location" class="form-control"  value="<%= trip.end_location ?? '' %>" >
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">Status</label>
        <select name="status" class="form-select" >
              <option value="planned" <%= trip.status === 'planned' ? 'selected' : '' %>>planned</option>
              <option value="started" <%= trip.status === 'started' ? 'selected' : '' %>>started</option>
              <option value="completed" <%= trip.status === 'completed' ? 'selected' : '' %>>completed</option>
        </select>
      </div>
      </div>
      <div class="mt-3">
        <button class="btn btn-warning"><i class="bi bi-check-lg"></i> Update</button>
        <a href="/trips" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div></div>
</main>

<%- include('../partials/footer') %>

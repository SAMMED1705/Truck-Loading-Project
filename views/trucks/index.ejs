<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="main-content">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-truck"></i> Trucks</h2>
    <a href="/trucks/create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Truck</a>
  </div>
  <%- include('../partials/flash') %>
  <div class="list-card">
    <div class="list-header">
      <h5>Fleet Management</h5>
      <span class="text-muted" style="font-size: 0.85rem;">Manage company trucks, planned route and capacity</span>
    </div>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead style="background: #f9fafb; font-size: 0.85rem; color: var(--text-muted);">
          <tr>
            <th class="border-0 rounded-start">#</th>
            <th class="border-0">Vehicle Number</th>
            <th class="border-0">Type</th>
            <th class="border-0">Capacity (KG)</th>
            <th class="border-0">Insurance Expiry</th>
            <th class="border-0">Status</th>
            <th class="border-0 rounded-end text-end" style="width:120px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (trucks.length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-5">
              <i class="bi bi-truck fs-1 text-light mb-3 d-block"></i>
              No trucks added yet.<br>
              <a href="/trucks/create" class="btn btn-sm btn-outline-primary mt-2">Add Truck</a>
            </td></tr>
          <% } %>
          <% trucks.forEach((item, i) => { %>
            <tr style="border-bottom: 1px solid #f3f4f6;">
              <td class="text-muted"><%= i + 1 %></td>
              <td class="fw-bold text-primary"><%= item.vehicle_number ?? '-' %></td>
              <td><span class="badge bg-light text-dark border"><%= item.vehicle_type %></span></td>
              <td><span class="fw-medium"><%= item.capacity_kg ?? '-' %></span> KG</td>
              <td><%= item.insurance_expiry?new Date(item.insurance_expiry).toLocaleDateString():'-' %></td>
              <td>
                <% if(item.status === 'Active') { %> <span class="badge-soft badge-available">Active</span>
                <% } else if(item.status === 'Inactive') { %> <span class="badge bg-secondary">Inactive</span>
                <% } else { %> <span class="badge bg-secondary"><%= item.status %></span> <% } %>
              </td>
              <td class="text-end">
                <a href="/trucks/<%= item.id %>" class="btn btn-sm btn-light text-primary"><i class="bi bi-eye"></i></a>
                <a href="/trucks/<%= item.id %>/edit" class="btn btn-sm btn-light text-warning"><i class="bi bi-pencil"></i></a>
                <form action="/trucks/<%= item.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this record?');">
                  <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

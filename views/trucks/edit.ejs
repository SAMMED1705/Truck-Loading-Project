<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-truck"></i> Edit Truck</h2>
    <a href="/trucks" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <form action="/trucks/<%= truck.id %>?_method=PUT" method="POST">
      <div class="row">
        <div class="col-md-6 mb-3"><label class="form-label">Vehicle Number <span class="text-danger">*</span></label>
      <input type="text" name="vehicle_number" class="form-control"  value="<%= truck.vehicle_number ?? '' %>" required>
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">Type</label>
        <select name="vehicle_type" class="form-select" >
              <option value="truck" <%= truck.vehicle_type === 'truck' ? 'selected' : '' %>>truck</option>
              <option value="trailer" <%= truck.vehicle_type === 'trailer' ? 'selected' : '' %>>trailer</option>
              <option value="container" <%= truck.vehicle_type === 'container' ? 'selected' : '' %>>container</option>
              <option value="tempo" <%= truck.vehicle_type === 'tempo' ? 'selected' : '' %>>tempo</option>
        </select>
      </div>
        <div class="col-md-6 mb-3"><label class="form-label">Capacity (KG) <span class="text-danger">*</span></label>
      <input type="number" name="capacity_kg" class="form-control" step="0.01" value="<%= truck.capacity_kg ?? '' %>" required>
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">Insurance Policy</label>
      <input type="text" name="insurance_policy_number" class="form-control"  value="<%= truck.insurance_policy_number ?? '' %>" >
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">Insurance Expiry</label>
      <input type="datetime-local" name="insurance_expiry" class="form-control"  value="<%= truck.insurance_expiry ?? '' %>" >
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">GPS Device ID</label>
      <input type="text" name="gps_device_id" class="form-control"  value="<%= truck.gps_device_id ?? '' %>" >
    </div>
        <div class="col-md-6 mb-3"><div class="form-check mt-4">
        <input type="checkbox" name="gps_active" class="form-check-input" <%= truck.gps_active?'checked':'' %>>
        <label class="form-check-label">GPS Active</label>
      </div></div>
        <div class="col-md-6 mb-3"><label class="form-label">Current Location</label>
      <input type="text" name="current_location" class="form-control"  value="<%= truck.current_location ?? '' %>" >
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">Owner ID</label>
      <input type="number" name="owner_id" class="form-control"  value="<%= truck.owner_id ?? '' %>" >
    </div>
        <div class="col-md-6 mb-3"><label class="form-label">Status</label>
        <select name="status" class="form-select" >
              <option value="available" <%= truck.status === 'available' ? 'selected' : '' %>>available</option>
              <option value="on_trip" <%= truck.status === 'on_trip' ? 'selected' : '' %>>on_trip</option>
              <option value="inactive" <%= truck.status === 'inactive' ? 'selected' : '' %>>inactive</option>
        </select>
      </div>
      </div>
      <div class="mt-3">
        <button class="btn btn-warning"><i class="bi bi-check-lg"></i> Update</button>
        <a href="/trucks" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div></div>
</main>

<%- include('../partials/footer') %>

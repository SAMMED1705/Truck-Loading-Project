<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-truck"></i> Truck Details</h2>
    <div>
      <a href="/trucks/<%= truck.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/trucks" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Vehicle Number</th><td><%= truck.vehicle_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">Type</th><td><%= truck.vehicle_type ?? '-' %></td></tr>
        <tr><th style="width:240px;">Capacity (KG)</th><td><%= truck.capacity_kg ?? '-' %></td></tr>
        <tr><th style="width:240px;">Insurance Policy</th><td><%= truck.insurance_policy_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">Insurance Expiry</th><td><%= truck.insurance_expiry ?? '-' %></td></tr>
        <tr><th style="width:240px;">GPS Device ID</th><td><%= truck.gps_device_id ?? '-' %></td></tr>
        <tr><th style="width:240px;">GPS Active</th><td><%= truck.gps_active ?? '-' %></td></tr>
        <tr><th style="width:240px;">Current Location</th><td><%= truck.current_location ?? '-' %></td></tr>
        <tr><th style="width:240px;">Owner ID</th><td><%= truck.owner_id ?? '-' %></td></tr>
        <tr><th style="width:240px;">Status</th><td><%= truck.status ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>

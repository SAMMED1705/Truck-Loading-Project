<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-cash-stack"></i> Expense Details</h2>
    <div>
      <a href="/expenses/<%= expense.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/expenses" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Type</th><td><%= expense.expense_type ?? '-' %></td></tr>
        <tr><th style="width:240px;">Amount</th><td><%= expense.amount ?? '-' %></td></tr>
        <tr><th style="width:240px;">Date</th><td><%= expense.expense_date ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'SmartLogiX' %></title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Bootstrap & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Custom CSS -->
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-dark sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand text-warning" href="/">
      <i class="bi bi-truck fs-3"></i>
      <div>
        <div style="line-height: 1;">SmartLogiX</div>
        <span class="brand-sub">Local Routes. Bigger Opportunities.</span>
      </div>
    </a>
    
    <div class="search-bar d-none d-md-flex mx-auto">
      <i class="bi bi-search me-2"></i>
      <input type="text" placeholder="Search loads, trucks, drivers, locations...">
    </div>

    <div class="d-flex align-items-center text-white">
      <div class="me-4 d-none d-md-block text-end">
        <div class="fw-bold"><i class="bi bi-geo-alt-fill"></i> Hubli-Dharwad</div>
        <div style="font-size: 0.7rem; color: #cbd5e1;">ಹುಬ್ಬಳ್ಳಿ-ಧಾರವಾಡ</div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <img src="https://ui-avatars.com/api/?name=Ramesh+Kumar&background=random" class="rounded-circle" width="35" height="35" alt="User">
        <div class="d-none d-md-block" style="line-height: 1.2;">
          <div style="font-size: 0.9rem; font-weight: 500;">Ramesh Kumar</div>
          <div style="font-size: 0.75rem; color: #9ca3af;">Truck Owner <i class="bi bi-chevron-down ms-1"></i></div>
        </div>
      </div>
    </div>
  </div>
</nav>

<div class="container-fluid p-0">
  <div class="row g-0">

<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-credit-card"></i> Payment Details</h2>
    <div>
      <a href="/payments/<%= payment.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/payments" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Payment No.</th><td><%= payment.payment_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">Amount</th><td><%= payment.amount ?? '-' %></td></tr>
        <tr><th style="width:240px;">Date</th><td><%= payment.payment_date ?? '-' %></td></tr>
        <tr><th style="width:240px;">Method</th><td><%= payment.payment_method ?? '-' %></td></tr>
        <tr><th style="width:240px;">Status</th><td><%= payment.status ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-boxes"></i> Master Load Details</h2>
    <div>
      <a href="/master_loads/<%= masterLoad.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/master_loads" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Master No.</th><td><%= masterLoad.master_load_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">Container</th><td><%= masterLoad.container_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">Weight (KG)</th><td><%= masterLoad.total_weight_kg ?? '-' %></td></tr>
        <tr><th style="width:240px;">Origin</th><td><%= masterLoad.origin ?? '-' %></td></tr>
        <tr><th style="width:240px;">Destination</th><td><%= masterLoad.destination ?? '-' %></td></tr>
        <tr><th style="width:240px;">Status</th><td><%= masterLoad.status ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<main class="main-content">
  
  <!-- Stats Row -->
  <div class="row mb-4 g-3">
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-icon" style="background: #eff6ff; color: #3b82f6;">
          <i class="bi bi-truck"></i>
        </div>
        <div>
          <div class="stat-label">Available Trucks</div>
          <div class="d-flex align-items-baseline gap-2">
            <h3 class="stat-value"><%= stats.availableTrucks %></h3>
            <span class="stat-trend trend-up"><i class="bi bi-arrow-up-short"></i> 12%</span>
          </div>
          <div class="stat-label" style="font-size: 0.7rem;">Out of <%= stats.totalTrucks %> total</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-icon" style="background: #eff6ff; color: #3b82f6;">
          <i class="bi bi-box-seam"></i>
        </div>
        <div>
          <div class="stat-label">Active Loads</div>
          <div class="d-flex align-items-baseline gap-2">
            <h3 class="stat-value"><%= stats.activeLoads %></h3>
            <span class="stat-trend trend-up"><i class="bi bi-arrow-up-short"></i> 8%</span>
          </div>
          <div class="stat-label" style="font-size: 0.7rem;">Today's postings</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-icon" style="background: #fdf4ff; color: #d946ef;">
          <i class="bi bi-calendar-event"></i>
        </div>
        <div>
          <div class="stat-label">Today's Bookings</div>
          <div class="d-flex align-items-baseline gap-2">
            <h3 class="stat-value"><%= stats.totalBookings %></h3>
            <span class="stat-trend trend-up"><i class="bi bi-arrow-up-short"></i> 22%</span>
          </div>
          <div class="stat-label" style="font-size: 0.7rem;">vs. yesterday</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="stat-card">
        <div class="stat-icon" style="background: #ecfdf5; color: #10b981;">
          <i class="bi bi-geo-alt"></i>
        </div>
        <div>
          <div class="stat-label">Total Distance (Today)</div>
          <div class="d-flex align-items-baseline gap-2">
            <h3 class="stat-value"><%= stats.totalDistance.toLocaleString() %> <span style="font-size: 1rem;">km</span></h3>
            <span class="stat-trend trend-up"><i class="bi bi-arrow-up-short"></i> 15%</span>
          </div>
          <div class="stat-label" style="font-size: 0.7rem;">Across <%= stats.tripsWithDistance %> trips</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <!-- Left Column -->
    <div class="col-md-8">
      
      <!-- Map Section -->
      <div class="map-container mb-4 position-relative">
        <iframe 
          src="https://maps.google.com/maps?q=Hubli+to+Dharwad&t=&z=11&ie=UTF8&iwloc=&output=embed" 
          width="100%" 
          height="100%" 
          frameborder="0" 
          style="border:0;" 
          allowfullscreen="" 
          aria-hidden="false" 
          tabindex="0">
        </iframe>
        
        <!-- Invisible Overlay Anchor Hook to Google Maps -->
        <a href="https://www.google.com/maps/dir/Hubli/Dharwad" target="_blank" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 5; cursor: pointer;"></a>

        <div class="map-controls" style="z-index: 6; pointer-events: none;">
          <button class="active">Map</button>
          <button>Satellite</button>
        </div>

        <!-- Dummy Truck 1 -->
        <div class="position-absolute" style="top: 45%; left: 35%; z-index: 6; pointer-events: none;">
           <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 35px; height: 35px; border: 2px solid white;">
             <i class="bi bi-truck" style="font-size: 1rem;"></i>
           </div>
        </div>
        
        <!-- Dummy Truck 2 -->
        <div class="position-absolute" style="top: 65%; left: 55%; z-index: 6; pointer-events: none;">
           <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 35px; height: 35px; border: 2px solid white;">
             <i class="bi bi-truck" style="font-size: 1rem;"></i>
           </div>
        </div>

        <!-- Absolute positioned pin info for demo purposes -->
        <div class="position-absolute bg-white rounded p-2 shadow-sm d-flex align-items-center gap-2" style="top: 25%; left: 45%; border: 1px solid #e5e7eb; z-index: 6; pointer-events: none;">
          <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?w=50&h=50&fit=crop" class="rounded" alt="Truck">
          <div>
            <div class="fw-bold" style="font-size: 0.8rem;">KA25AB1234 <span class="badge bg-success ms-2">On Trip</span></div>
            <div style="font-size: 0.7rem; color: var(--text-muted);">16 Ton • Container</div>
            <div style="font-size: 0.7rem;"><i class="bi bi-geo-alt-fill text-primary"></i> Hubli <i class="bi bi-arrow-right"></i> Dharwad</div>
            <div style="font-size: 0.7rem; color: var(--text-muted);">ETA: 1h 15m</div>
          </div>
        </div>
      </div>

      <!-- Lower Left Row -->
      <div class="row g-3">
        <!-- Trip Progress -->
        <div class="col-md-6">
          <div class="list-card h-100">
            <div class="list-header">
              <h5>Trip Progress</h5>
              <a href="/trips">View All</a>
            </div>
            <div class="position-relative ms-3 border-start border-2 border-primary" style="padding-left: 20px;">
              <div class="position-absolute bg-success rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 0;"></div>
              <div class="mb-4">
                <div class="d-flex justify-content-between">
                  <div class="fw-bold text-success">Hubli</div>
                  <div class="text-muted" style="font-size: 0.8rem;">08:00 AM</div>
                </div>
                <div style="font-size: 0.8rem; color: var(--success);">Pickup Completed</div>
              </div>

              <div class="position-absolute bg-primary rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 30%;"></div>
              <div class="mb-4">
                <div class="d-flex justify-content-between">
                  <div class="fw-bold text-primary">Dharwad</div>
                  <div class="text-muted" style="font-size: 0.8rem;">ETA 09:15 AM</div>
                </div>
                <div style="font-size: 0.8rem; color: var(--secondary);">In Progress</div>
              </div>

              <div class="position-absolute bg-secondary rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 60%;"></div>
              <div class="mb-4">
                <div class="d-flex justify-content-between">
                  <div class="fw-bold text-muted">Kalaghatagi</div>
                  <div class="text-muted" style="font-size: 0.8rem;">ETA 10:45 AM</div>
                </div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Upcoming</div>
              </div>

              <div class="position-absolute bg-secondary rounded-circle" style="width: 12px; height: 12px; left: -7px; top: 90%;"></div>
              <div>
                <div class="d-flex justify-content-between">
                  <div class="fw-bold text-muted">Belur</div>
                  <div class="text-muted" style="font-size: 0.8rem;">ETA 12:30 PM</div>
                </div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Upcoming</div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Price Calculator -->
        <div class="col-md-6">
          <div class="price-calculator h-100">
            <h5 class="d-flex align-items-center gap-2">
              Price Calculator
              <i class="bi bi-info-circle text-muted" style="font-size: 0.9rem; cursor: pointer;" data-bs-toggle="tooltip" data-bs-placement="top" title="Calculation factors: Distance (approximate routing), Base Freight (₹2.5/km/ton), Toll Tax, Loading & Unloading fees"></i>
            </h5>
            <p class="text-muted" style="font-size: 0.85rem;">Calculate your freight cost</p>
            
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label style="font-size: 0.8rem; font-weight: 500;">From</label>
                <input type="text" id="calc-from" class="form-control form-control-sm" value="Hubli">
              </div>
              <div class="col-6">
                <label style="font-size: 0.8rem; font-weight: 500;">To</label>
                <input type="text" id="calc-to" class="form-control form-control-sm" value="Dharwad">
              </div>
            </div>
            
            <div class="mb-3">
              <label style="font-size: 0.8rem; font-weight: 500;">Weight (KG)</label>
              <input type="number" id="calc-weight" class="form-control form-control-sm" value="5000">
            </div>
            <div class="mb-3">
              <label style="font-size: 0.8rem; font-weight: 500;">Truck Type</label>
              <select id="calc-type" class="form-select form-select-sm">
                <option value="1">16 Ton (Container)</option>
                <option value="1.2">20 Ton (Container)</option>
                <option value="1.5">25 Ton (Open)</option>
              </select>
            </div>
            
            <div class="mb-3 d-flex gap-3" style="font-size: 0.85rem;">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="loadType" id="calc-shared" value="0.7" checked>
                <label class="form-check-label" for="calc-shared">Shared</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="loadType" id="calc-direct" value="1">
                <label class="form-check-label" for="calc-direct">Direct</label>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <div style="font-size: 0.8rem;">Estimated Cost</div>
                <h3 class="text-primary fw-bold mb-0" id="calc-est-cost">₹ 0</h3>
              </div>
              <div style="font-size: 0.8rem; text-align: right;">
                <div>Base Freight <span class="ms-2" id="calc-base">₹ 0</span></div>
                <div>Toll Charges <span class="ms-2" id="calc-toll">₹ 0</span></div>
                <div>Loading <span class="ms-2" id="calc-load">₹ 0</span></div>
                <div>Unloading <span class="ms-2" id="calc-unload">₹ 0</span></div>
                <div class="fw-bold mt-1">Total <span class="ms-2" id="calc-total">₹ 0</span></div>
              </div>
            </div>
            <button id="calc-btn" class="btn btn-primary w-100 fw-bold">Calculate Price</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column -->
    <div class="col-md-4">
      
      <!-- Available Loads -->
      <div class="list-card">
        <div class="list-header">
          <h5>Available Loads <span class="fw-normal text-muted" style="font-size: 0.9rem;">(Hubli - Dharwad)</span></h5>
          <a href="/loads">View All</a>
        </div>
        
        <div class="list-item">
          <div class="d-flex gap-3 align-items-center">
            <div class="item-icon" style="background: #fee2e2; color: #ef4444;"><i class="bi bi-basket-fill fs-4"></i></div>
            <div>
              <div class="fw-bold">Onion <span class="fw-normal text-muted" style="font-size: 0.85rem;">(5,000 KG)</span></div>
              <div style="font-size: 0.8rem; color: var(--text-muted);"><i class="bi bi-geo-alt text-success"></i> Hubli <i class="bi bi-arrow-right mx-1"></i> Dharwad</div>
              <div class="fw-bold mt-1">₹ 12,500</div>
            </div>
          </div>
          <div class="text-end">
            <span class="badge-soft badge-shared d-inline-block mb-2">Shared</span>
            <div class="text-muted" style="font-size: 0.75rem;">Posted 2h ago</div>
          </div>
        </div>

        <div class="list-item">
          <div class="d-flex gap-3 align-items-center">
            <div class="item-icon" style="background: #fef3c7; color: #d97706;"><i class="bi bi-box-fill fs-4"></i></div>
            <div>
              <div class="fw-bold">Cement <span class="fw-normal text-muted" style="font-size: 0.85rem;">(15,000 KG)</span></div>
              <div style="font-size: 0.8rem; color: var(--text-muted);"><i class="bi bi-geo-alt text-success"></i> Hubli <i class="bi bi-arrow-right mx-1"></i> Dharwad</div>
              <div class="fw-bold mt-1">₹ 28,000</div>
            </div>
          </div>
          <div class="text-end">
            <span class="badge-soft badge-direct d-inline-block mb-2">Direct</span>
            <div class="text-muted" style="font-size: 0.75rem;">Posted 4h ago</div>
          </div>
        </div>

        <div class="list-item">
          <div class="d-flex gap-3 align-items-center">
            <div class="item-icon" style="background: #f3f4f6; color: #6b7280;"><i class="bi bi-bag-fill fs-4"></i></div>
            <div>
              <div class="fw-bold">Rice <span class="fw-normal text-muted" style="font-size: 0.85rem;">(10,000 KG)</span></div>
              <div style="font-size: 0.8rem; color: var(--text-muted);"><i class="bi bi-geo-alt text-success"></i> Dharwad <i class="bi bi-arrow-right mx-1"></i> Hubli</div>
              <div class="fw-bold mt-1">₹ 22,000</div>
            </div>
          </div>
          <div class="text-end">
            <span class="badge-soft badge-shared d-inline-block mb-2">Shared</span>
            <div class="text-muted" style="font-size: 0.75rem;">Posted 5h ago</div>
          </div>
        </div>

        <div class="list-item border-0">
          <div class="d-flex gap-3 align-items-center">
            <div class="item-icon" style="background: #e0f2fe; color: #0284c7;"><i class="bi bi-bag-fill fs-4"></i></div>
            <div>
              <div class="fw-bold">Sugar <span class="fw-normal text-muted" style="font-size: 0.85rem;">(20,000 KG)</span></div>
              <div style="font-size: 0.8rem; color: var(--text-muted);"><i class="bi bi-geo-alt text-success"></i> Hubli <i class="bi bi-arrow-right mx-1"></i> Belagavi</div>
              <div class="fw-bold mt-1">₹ 40,000</div>
            </div>
          </div>
          <div class="text-end">
            <span class="badge-soft badge-direct d-inline-block mb-2">Direct</span>
            <div class="text-muted" style="font-size: 0.75rem;">Posted 6h ago</div>

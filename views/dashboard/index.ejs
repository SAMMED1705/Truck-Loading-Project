        </div>

        <div class="list-item">
          <div class="d-flex gap-3 align-items-center">
            <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?w=40&h=40&fit=crop" class="rounded" alt="Truck">
            <div>
              <div class="fw-bold" style="font-size: 0.9rem;">KA25AB1234</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);">16 Ton • Container</div>
              <div style="font-size: 0.75rem; font-weight: 500;">Hubli <span class="text-muted fw-normal ms-1">• 6T available</span></div>
            </div>
          </div>
          <div>
            <span class="badge-soft badge-available">Available</span>
            <i class="bi bi-chevron-right text-muted ms-2" style="font-size: 0.8rem;"></i>
          </div>
        </div>

        <div class="list-item">
          <div class="d-flex gap-3 align-items-center">
            <img src="https://images.unsplash.com/photo-1519003722824-194d4455a60c?w=40&h=40&fit=crop" class="rounded" alt="Truck">
            <div>
              <div class="fw-bold" style="font-size: 0.9rem;">KA25CD5678</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);">25 Ton • Open</div>
              <div style="font-size: 0.75rem; font-weight: 500;">Dharwad <span class="text-muted fw-normal ms-1">• 12T available</span></div>
            </div>
          </div>
          <div>
            <span class="badge-soft badge-available">Available</span>
            <i class="bi bi-chevron-right text-muted ms-2" style="font-size: 0.8rem;"></i>
          </div>
        </div>

        <div class="list-item">
          <div class="d-flex gap-3 align-items-center">
            <img src="https://images.unsplash.com/photo-1586864387967-d02ef85d93e8?w=40&h=40&fit=crop" class="rounded" alt="Truck">
            <div>
              <div class="fw-bold" style="font-size: 0.9rem;">KA24EF9012</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);">12 Ton • Closed</div>
              <div style="font-size: 0.75rem; font-weight: 500;">Hubli <span class="text-muted fw-normal ms-1">• 4T available</span></div>
            </div>
          </div>
          <div>
            <span class="badge-soft badge-available">Available</span>
            <i class="bi bi-chevron-right text-muted ms-2" style="font-size: 0.8rem;"></i>
          </div>
        </div>

        <div class="list-item border-0">
          <div class="d-flex gap-3 align-items-center">
            <img src="https://images.unsplash.com/photo-1611145371285-d6c5cc2478d5?w=40&h=40&fit=crop" class="rounded" alt="Truck">
            <div>
              <div class="fw-bold" style="font-size: 0.9rem;">KA28GH3456</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);">20 Ton • Container</div>
              <div style="font-size: 0.75rem; font-weight: 500;">Dharwad <span class="text-muted fw-normal ms-1">• 8T available</span></div>
            </div>
          </div>
          <div>
            <span class="badge-soft badge-transit">In Transit</span>
            <i class="bi bi-chevron-right text-muted ms-2" style="font-size: 0.8rem;"></i>
          </div>
        </div>
        
      </div>
    </div>

  </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Initialize tooltips
  const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
  const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

  const btn = document.getElementById('calc-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      // Dummy distance calculation for demo
      const from = document.getElementById('calc-from').value.trim();
      const to = document.getElementById('calc-to').value.trim();
      
      let distance = 250; // default distance
      if (from.toLowerCase() === 'hubli' && to.toLowerCase() === 'dharwad') distance = 20;
      else if (from.toLowerCase() === 'hubli' && to.toLowerCase() === 'belagavi') distance = 100;
      else if (from.toLowerCase() === 'hubli' && to.toLowerCase() === 'bengaluru') distance = 400;

      const weight = parseInt(document.getElementById('calc-weight').value) || 0;
      const typeMultiplier = parseFloat(document.getElementById('calc-type').value);
      
      const isShared = document.getElementById('calc-shared').checked;
      const loadMultiplier = isShared ? 0.6 : 1;

      // Base Freight: Distance * (Weight in tons) * base rate * multipliers
      // e.g. Hubli to Dharwad (20km), 5 tons -> 20 * 5 * 10 = 1000 base
      const tons = weight / 1000;
      const baseRatePerTonKm = 15; // realistic dummy rate
      let base = distance * tons * baseRatePerTonKm * typeMultiplier * loadMultiplier;
      
      // Minimum base charge
      if (base < 1500) base = 1500;
      
      // Toll charges approx 2.5% of base
      let toll = Math.round(base * 0.025);
      
      // Loading/Unloading fixed logic
      let loadCost = Math.round(250 * typeMultiplier * (tons > 0 ? (tons / 2) : 1));
      let unloadCost = Math.round(250 * typeMultiplier * (tons > 0 ? (tons / 2) : 1));

      let total = base + toll + loadCost + unloadCost;

      document.getElementById('calc-base').innerText = `₹ ${Math.round(base).toLocaleString()}`;
      document.getElementById('calc-toll').innerText = `₹ ${toll.toLocaleString()}`;
      document.getElementById('calc-load').innerText = `₹ ${loadCost.toLocaleString()}`;
      document.getElementById('calc-unload').innerText = `₹ ${unloadCost.toLocaleString()}`;
      document.getElementById('calc-total').innerText = `₹ ${Math.round(total).toLocaleString()}`;
      document.getElementById('calc-est-cost').innerText = `₹ ${Math.round(total).toLocaleString()}`;
    });

    // Trigger calculation initially
    btn.click();
  }
});
</script>


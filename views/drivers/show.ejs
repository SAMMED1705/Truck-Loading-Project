<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="col-md-10 ms-sm-auto px-md-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi-person-badge"></i> Driver Details</h2>
    <div>
      <a href="/drivers/<%= driver.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <a href="/drivers" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
  </div>
  <%- include('../partials/flash') %>
  <div class="card shadow-sm"><div class="card-body">
    <table class="table table-borderless">
        <tr><th style="width:240px;">Name</th><td><%= driver.name ?? '-' %></td></tr>
        <tr><th style="width:240px;">Phone</th><td><%= driver.phone ?? '-' %></td></tr>
        <tr><th style="width:240px;">License No.</th><td><%= driver.license_number ?? '-' %></td></tr>
        <tr><th style="width:240px;">License Expiry</th><td><%= driver.license_expiry ?? '-' %></td></tr>
        <tr><th style="width:240px;">Experience (Years)</th><td><%= driver.experience_years ?? '-' %></td></tr>
        <tr><th style="width:240px;">Status</th><td><%= driver.status ?? '-' %></td></tr>
    </table>
  </div></div>
</main>

<%- include('../partials/footer') %>
